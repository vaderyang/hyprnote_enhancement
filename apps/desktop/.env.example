# Netis Global LLM API Configuration
# This is the API key for the Netis Global AI service
# Get your API key from https://llm.netis.io
VITE_NETIS_GLOBAL_API_KEY=

# Template Classifier Configuration
# Model to use for template classification (default: defaultModel)
VITE_AI_TEMPLATE_CLASSIFIER_MODEL=defaultModel

# Timeout for template classification in milliseconds (default: 4500)
VITE_AI_TEMPLATE_CLASSIFIER_TIMEOUT_MS=4500

# Feature flag for auto template selection (default: true)
VITE_FEATURE_AUTO_TEMPLATE_SELECT=true
