{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pinote",
  "mainBinaryName": "Pinote",
  "identifier": "com.pinote.stable",
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://desktop.pinote.org/update/{{target}}-{{arch}}/{{current_version}}?channel=stable"
      ]
    }
  }
}
